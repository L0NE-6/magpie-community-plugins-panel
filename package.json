{
  "name": "magpie-community-plugins",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "bun scripts/check.mjs",
    "panel:check": "node scripts/panel-check.mjs",
    "panel:check:fixture": "node scripts/panel-check.mjs --fixture",
    "panel:priority": "node scripts/panel-priority.mjs",
    "panel:priority:check": "node scripts/panel-priority.mjs --check",
    "panel:sync": "node scripts/panel-sync.mjs",
    "panel:sync:fixture": "node scripts/panel-sync.mjs --fixture --out .sandbox/panel-fixture",
    "panel:test": "bun test scripts/panel.test.mjs"
  }
}
